+void GfxViewer::SetAlwaysOnTop(bool enabled)
+{
+#ifdef __WXMSW__
+    // Ownership keeps the viewer above the emulator without making it
+    // topmost over other applications.
+    const auto window = GetHandle();
+    const auto owner = enabled ? wxGetApp().frame->GetHandle() : nullptr;
+    ::SetWindowLongPtrW(window, GWLP_HWNDPARENT, reinterpret_cast<LONG_PTR>(owner));
+    if (enabled && IsShown()) {
+        ::SetWindowPos(window, HWND_TOP, 0, 0, 0, 0,
+                       SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+    }
+#else
+    const long style = GetWindowStyle();
+    SetWindowStyle(enabled ? style | wxSTAY_ON_TOP : style & ~wxSTAY_ON_TOP);
+#endif
+}
+
+void GfxViewer::OnMainFrameIconize(wxIconizeEvent& event)
+{
+    event.Skip();
+#ifdef __WXMSW__
+    // Windows already hides and restores owned viewers with the main window.
+    if (::GetWindow(GetHandle(), GW_OWNER))
+        return;
+#endif
+
+    if (event.IsIconized()) {
+        if (IsShown())
+            hidden_for_main_frame_ = Hide();
+    } else if (hidden_for_main_frame_) {
+        hidden_for_main_frame_ = false;
+#ifdef __WXMSW__
+        ShowWithoutActivating();
+#else
+        Show();
+#endif
+    }
 }
 
