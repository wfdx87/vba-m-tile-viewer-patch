+
+void GfxViewer::ZoomSel(wxCommandEvent& ev)
+{
+    int sel = ev.GetSelection();
 
+    if (sel < 0)
+        return;
+
+    zoom_ = sel + 1;
+    ApplyZoom();
+}
+
+void GfxViewer::ApplyZoom()
+{
+    // zooming and stretching are mutually exclusive
+    str_->SetValue(false);
+
+    wxSize sz(gv->bmw * zoom_, gv->bmh * zoom_);
+
+    // grow the view to show the zoomed tiles, but never beyond what fits
+    // on the screen (scrollbars take over past that point)
+    wxSize border = gvs_->GetSize() - gvs_->GetClientSize();
+    wxSize want = sz + border;
+    int disp = wxDisplay::GetFromWindow(this);
+    wxRect area = wxDisplay(disp == wxNOT_FOUND ? 0 : disp).GetClientArea();
+    want.DecTo(wxSize(area.GetWidth() * 3 / 4, area.GetHeight() * 3 / 4));
+    want.IncTo(gvs_min_);
+
+    gvs_->SetMinSize(want);
+    gvs_->SetSize(want);
     gv->SetSize(sz);
     gvs_->SetVirtualSize(sz);
+    gvs_->Scroll(0, 0);
+
+    // resize the dialog so the new view fits
+    wxSize fit = GetSizer()->ComputeFittingWindowSize(this);
+    SetMinSize(fit);
+
+    if (zoom_ == 1) {
+        SetSize(fit);
+    } else {
+        wxSize cur = GetSize();
+        cur.IncTo(fit);
+        SetSize(cur);
+    }
+
+    Layout();
+    gv->Refresh();
 }
 
